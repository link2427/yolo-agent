# ============================================================================
# yolo-agent-cpp runtime configuration.
#
# Copy this file to `config/cpp.env`. Everything from config/base.env.example
# applies here too (VLLM_*, GITEA_*, YOLO_* limits); this file only documents
# what the C++ container adds or changes.
# ============================================================================

# --- Model endpoint (same as the base image) --------------------------------
# Uncomment and edit these; see config/base.env.example for the full notes.
#VLLM_BASE_URL=http://192.168.1.50:8000/v1
#VLLM_MODEL=Qwen/Qwen3.8-27B
#VLLM_CONTEXT=262144
#VLLM_REASONING_EFFORT=xhigh
#VLLM_API_KEY=local

# --- Build behavior ---------------------------------------------------------
# CMake toolchain files shipped in the image:
#   /opt/yolo/cmake-toolchains/mingw-w64-x86_64.cmake    -> 64-bit Windows PE
#   /opt/yolo/cmake-toolchains/linux-x86_64-clang.cmake  -> native ELF64
# cpp-build.sh uses both automatically:
#   cpp-build.sh <source-dir> [linux|windows|both]

# Default build type used by cpp-build.sh (Release|Debug|RelWithDebInfo).
#CMAKE_BUILD_TYPE=Release

# Parallel jobs for cpp-build.sh. Defaults to nproc.
#YOLO_BUILD_JOBS=6

# ccache lives in the home volume, so it survives container replacement.
#CCACHE_DIR=/home/agent/.cache/ccache
#CCACHE_MAXSIZE=20G

# --- Resource limits (compilation is heavier than agent traffic) ------------
# Host-side: Compose and the launchers read YOLO_MEM / YOLO_CPUS from the shell
# or a repo-root .env, NOT from this file. compose.cpp.yaml defaults to 12g/6.
#YOLO_MEM=12g
#YOLO_CPUS=6

# --- Git: push to your air-gapped Gitea server ------------------------------
#GITEA_HOST=server4:3000
#GITEA_USER=agent
#GITEA_TOKEN=
#GIT_NAME=Agent
#GIT_EMAIL=agent@gitea.local
