# ============================================================================
# yolo-agent-reverse-engineering runtime configuration.
#
# Copy this file to `config/reverse.env`. Everything from
# config/base.env.example applies here too (VLLM_*, GITEA_*, YOLO_* limits);
# this file only documents what the reverse container adds or changes.
# ============================================================================

# --- Model endpoint (same as the base image) --------------------------------
# Uncomment and edit these; see config/base.env.example for the full notes.
#VLLM_BASE_URL=http://192.168.1.50:8000/v1
#VLLM_MODEL=Qwen/Qwen3.8-27B
#VLLM_CONTEXT=262144
#VLLM_REASONING_EFFORT=xhigh
#VLLM_API_KEY=local

# --- Toolchain locations (baked; documented for scripts and prompts) --------
#   python   /opt/pyenv/bin/python3     one Python 3.11 environment
#   pycdc    /usr/local/bin/pycdc       C++ Python-bytecode decompiler
#   pycdas   /usr/local/bin/pycdas      matching disassembler
#   jadx     /usr/local/bin/jadx        DEX/APK -> Java
#   ghidra   /usr/local/bin/ghidra-headless
#   r2       /usr/bin/r2                radare2
#   java     /opt/java (Temurin JDK 21; JAVA_HOME is pre-set)

# --- Ghidra state -----------------------------------------------------------
# Ghidra needs a writable directory for projects and caches. It defaults to
# $HOME/.ghidra inside the persistent home volume; override to place large
# projects on the workspace mount instead.
#GHIDRA_USER_DIR=/workspace/.ghidra

# --- Java heap for Ghidra ---------------------------------------------------
# Raise for very large binaries; the compose default memory limit is 12g.
#JAVA_OPTS=-Xmx4g

# --- Resource limits (Ghidra's JVM and angr both want headroom) -------------
# Host-side: Compose and the launchers read YOLO_MEM / YOLO_CPUS from the shell
# or a repo-root .env, NOT from this file. compose.reverse.yaml defaults to 12g/6.
#YOLO_MEM=12g
#YOLO_CPUS=6

# --- Git: push to your air-gapped Gitea server ------------------------------
#GITEA_HOST=server4:3000
#GITEA_USER=agent
#GITEA_TOKEN=
#GIT_NAME=Agent
#GIT_EMAIL=agent@example.invalid
