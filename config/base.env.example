# ============================================================================
# yolo-agent runtime configuration — base image.
#
# Copy this file to `config/base.env` and edit it. Values are passed into the
# container at launch only; nothing here is baked into the image.
#
# The same VLLM_*/GITEA_* values work for all three images. yolo-agent-cpp and
# yolo-agent-reverse-engineering have their own examples
# (config/cpp.env.example, config/reverse.env.example) that add their extras.
# ============================================================================

# --- Model endpoint (OpenAI-compatible) -------------------------------------
# vLLM (default). Point at your vLLM server on the LAN, e.g.:
#   http://192.168.1.50:8000/v1
# (Run `curl $VLLM_BASE_URL/models` to list the model ids it serves.)
#
# These are deliberately COMMENTED OUT: the agents are only auto-configured
# once you set real values, so an unedited copy of this file cannot leave the
# container pointing at an address that does not exist. Uncomment and edit.
#VLLM_BASE_URL=http://192.168.1.50:8000/v1
#VLLM_MODEL=Qwen/Qwen3.8-27B

# Context window the agents should assume (tokens). Set it to what your vLLM
# server was started with (--max-model-len). Agents' built-in catalogs often
# default Qwen-class ids to 128k even when the server supports more.
# Leave empty/unset to use the agents' catalog defaults.
#VLLM_CONTEXT=262144

# Qwen3.8-27B official reasoning_effort: xhigh (default), medium, low.
# off disables thinking (instruct mode via enable_thinking=false).
# Wired into opencode (variants + default), pi, and DeepSeek Harness.
# Cycle in-session with pi's /effort or an opencode variant.
#VLLM_REASONING_EFFORT=xhigh

# Set to your real key only if the server requires auth. "local" is a safe
# placeholder for keyless vLLM / LM Studio servers.
#VLLM_API_KEY=local

# LM Studio alternative: comment the VLLM_* lines above and uncomment these.
# LM Studio's OpenAI-compatible server defaults to http://<host>:1234/v1
#LM_STUDIO_BASE_URL=http://192.168.1.50:1234/v1
#LM_STUDIO_MODEL=your-loaded-model-id

# Do not set DEEPSEEK_API_KEY or OPENAI_API_KEY: a cloud key would put remote
# models back in the agent pickers, and this host has no internet route.

# --- Browser services (exposed on the internal network) ---------------------
# code-server (:8080), ttyd (:7681), and DeepSeek Harness (:3080) bind to
# 0.0.0.0 by default (air-gapped LAN).
#
# IMPORTANT — these are read by Docker Compose on the HOST, not by the
# container, so setting them in THIS file (which is only a container env_file)
# has no effect: Compose substitutes ${...} before the container exists. Use
# either:
#
#   a) the shell:   YOLO_BIND_ADDRESS=127.0.0.1 docker compose up -d
#   b) a .env file in the REPOSITORY ROOT (next to compose.yaml) — the only
#      file Compose reads automatically for substitution:
#
#        # .env
#        YOLO_BIND_ADDRESS=127.0.0.1
#        YOLO_CODE_PORT=9090
#
# The names below are listed for reference only.
#YOLO_BIND_ADDRESS=0.0.0.0
#YOLO_CODE_PORT=8080
#YOLO_TERMINAL_PORT=7681
#YOLO_DSH_PORT=3080

# --- Git: push to your air-gapped Gitea server ------------------------------
# Token mode (default). Create an "agent" user in Gitea, generate an access
# token scoped to write:repository, then:
#GITEA_HOST=server4:3000
#GITEA_USER=agent
#GITEA_TOKEN=
#GIT_NAME=Agent
#GIT_EMAIL=agent@gitea.local
#
# SSH mode instead: uncomment GIT_SSH (and GITEA_SSH_PORT — Gitea often uses
# 2222). The container generates an ed25519 keypair on launch and prints the
# public key — paste it into the agent user's Gitea account (SSH keys).
#GIT_SSH=1
#GITEA_SSH_PORT=22
#
# If "server4" doesn't resolve inside the container, add its IP:
#GITEA_HOST_IP=192.168.x.x

# --- Resource limits (honored by the compose files and bin/ launchers) ------
#YOLO_MEM=8g
#YOLO_CPUS=4
