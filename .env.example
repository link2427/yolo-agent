# One person's settings. Copy next to compose.yaml as .env and edit.
# Everything here is optional except the ports when several people share a host.

# Which image tier: core (agents + web UIs), cpp (+ C/C++/Fortran toolchains),
# full (+ reverse-engineering tools).
YOLO_IMAGE=yolo-agent:3.0.0-full

# Whose workstation this is. Used for per-person fleet settings and usage in the
# monitor. Defaults to nothing (shared settings only).
YOLO_PERSON=

# Host ports. Give each person on the same machine their own block.
YOLO_PORT_HOME=8000
YOLO_PORT_CODE=8080
YOLO_PORT_CHAT=4096
YOLO_PORT_TERM=7681
YOLO_PORT_FILES=8081
# Listen address on the host. 127.0.0.1 keeps it to this machine only.
YOLO_BIND=0.0.0.0

# The person's Gitea token (Gitea → Settings → Applications → Generate token,
# scopes: repository and issue read/write, user read). Or run `yolo login` in
# the terminal instead, which stores it in the home volume.
GITEA_TOKEN=

# Model server. The defaults point at SEC09; use the lab monitor to get usage
# per person: VLLM_BASE_URL=http://<lab-host>:4000/v1
#VLLM_BASE_URL=http://192.168.1.101:8000/v1
#VLLM_MODEL=

# Resources for each service.
#YOLO_MEM=12g
#YOLO_CPUS=6
#YOLO_TMP_SIZE=4g
