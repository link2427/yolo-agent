# Lab services (compose.lab.yaml). Copy next to it as .env.

YOLO_IMAGE=yolo-agent:3.0.0-core

# --- monitor (gateway + dashboard) ------------------------------------------
LAB_PORT=4000
UPSTREAM_URL=http://192.168.1.101:8000
# Only if vLLM was started with --api-key:
UPSTREAM_API_KEY=
# Optional GPU exporter on SEC09 (tools/gpu-exporter.py), e.g. http://192.168.1.101:9400
GPU_URL=

# --- bot (PR review, @yolo mentions, scheduled jobs) -------------------------
BOT_PORT=9000
# Token of the bot's own Gitea account (create a user such as "yolo").
BOT_GITEA_TOKEN=
# How Gitea reaches the bot; used by `docker compose exec bot yolo bot hook <owner/repo>`.
BOT_PUBLIC_URL=http://CHANGE-ME:9000
# Shared secret for webhook signatures (any random string).
BOT_WEBHOOK_SECRET=
# opencode, claude or qwen
BOT_AGENT=opencode
BOT_MENTION=@yolo
