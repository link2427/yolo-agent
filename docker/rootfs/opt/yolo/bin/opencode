#!/usr/bin/env bash
# yolo wrapper for opencode: per-agent settings from ~/.yolo/env/opencode.env (written by
# yolo configure), then the real binary in /opt/agents.
if [[ -r "$HOME/.yolo/env/opencode.env" ]]; then
  # shellcheck source=/dev/null
  . "$HOME/.yolo/env/opencode.env"
fi
exec /opt/agents/bin/opencode "$@"
