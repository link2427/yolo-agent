# yolo-agent lab defaults. Lowest precedence:
#
#   1. this file (baked into the image)
#   2. fleet.env from the fleet repo in Gitea (yolo/fleet), if synced
#   3. people/<YOLO_PERSON>.env from the fleet repo
#   4. the container's own environment (the person's .env via compose) — wins
#
# Do not put secrets here. The Gitea token belongs in the person's .env or in
# ~/.yolo/secrets.env (written by `yolo login`).

# --- model endpoint: SEC09 vLLM ------------------------------------------------
VLLM_BASE_URL=http://192.168.1.101:8000/v1
# Empty = use the first model SEC09 serves (read from /v1/models at start).
VLLM_MODEL=
VLLM_API_KEY=local
# off | low | medium | xhigh  (Qwen3.8 reasoning effort)
VLLM_REASONING_EFFORT=xhigh
# Tokens; empty = take max_model_len from /v1/models when vLLM reports it.
VLLM_CONTEXT=
# Models that accept images. "auto" = every served model.
VLLM_VISION_MODELS=auto

# --- Gitea ----------------------------------------------------------------------
GITEA_HOST=192.168.1.27:3000
GITEA_PROTOCOL=http
# Empty = ask Gitea who owns the token.
GITEA_USER=
YOLO_FLEET_REPO=yolo/fleet
YOLO_SKILLS_REPO=yolo/skills

# --- git identity ---------------------------------------------------------------
GIT_NAME="YOLO Agent"
GIT_EMAIL=yoloagent@gmail.com

# --- skills enabled for everyone when nothing else says otherwise -------------
YOLO_DEFAULT_SKILLS="yolo-airgap yolo-gitea skill-creator"

# --- agents: offline switches ---------------------------------------------------
# opencode
OPENCODE_DISABLE_AUTOUPDATE=1
OPENCODE_DISABLE_MODELS_FETCH=1
OPENCODE_DISABLE_LSP_DOWNLOAD=1
OPENCODE_DISABLE_SHARE=1
# pi
PI_OFFLINE=1
PI_SKIP_VERSION_CHECK=1
PI_TELEMETRY=0
# Claude Code
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_AUTOUPDATER=1
DISABLE_UPDATES=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1
CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL=1
# Crush
CRUSH_DISABLE_METRICS=1
CRUSH_DISABLE_PROVIDER_AUTO_UPDATE=1
# Goose
GOOSE_TELEMETRY_ENABLED=false
GOOSE_TELEMETRY_OFF=1
# Codex
CODEX_DISABLE_UPDATE_CHECK=1
# generic
DO_NOT_TRACK=1
NO_UPDATE_NOTIFIER=1
npm_config_update_notifier=false
